<template>
	<view class="update-popup flex flex-ac jc-ct" :style="{ width: windowWidth + 'px',height: windowHeight + 'px' }">
		<view class="warp">
			<view class="main">
				<image src="/static/images/home/shade.png" class="shade"></image>
				<image src="/static/images/home/update.png" class="title"></image>
				<text class="tips flex flex-ac jc-ct">NEW VERSION</text>
				<text class="versions">v{{updateResult.version}}版本:</text>
				<text class="content">{{updateResult.contents}}</text>
				<view class="download flex flex-ac jc-ct" v-if="percent>0">
					<text class="load">下载中：</text>
					<progress :percent="percent" stroke-width="10" border-radius="10rpx" backgroundColor="#C4F6FC"
						activeColor="#10AEFF" class="progress" show-info />
				</view>
				<view class="update flex flex-ac jc-ct" @click="update" v-if="percent==0"
					:style="{ marginTop: (updateResult.is_mandatory? 104 : 40)+ 'rpx' }">
					<text
						class="txt">{{updateResult.type!='wgt'&&(updateResult.platform || []).includes('iOS')?'立即跳转更新':'立即更新'}}</text>
				</view>
				<text class="no-update flex flex-ac jc-ct" v-if="!updateResult.is_mandatory&&percent==0"
					@click="close">暂不更新</text>
			</view>
			<image src="/static/images/home/rocket.png" class="rockete"></image>
		</view>
	</view>
</template>

<script setup lang="ts">
	import { ref, onMounted, defineProps, defineEmits } from "vue";
	import { onLoad, onShow, onReady, onInit, onHide, onUnload } from "@dcloudio/uni-app";
	import { updateApp } from "@/infrastructure/utils/common";
	import { throttle } from 'lodash';
	// const props = defineProps(["updateResult"]);
	// const emits = defineEmits(["closeUpdate"]);
	const systemInfo = uni.getSystemInfoSync();
	const windowWidth = ref(systemInfo.screenWidth);
	const windowHeight = ref(systemInfo.screenHeight);
	const percent = ref(0);
	const updateResult = ref({});
	const isIos = ref(false);
	isIos.value = uni.getSystemInfoSync().platform == "ios";

	const close = () => {
		// emits('closeUpdate')
		console.log("触发subNVue")
		updateResult.value.close();
	}

	onLoad(() => {
		if (isIos.value) {
			// ios阻止左右侧滑返回
			// #ifdef APP-PLUS
			plus.webview.currentWebview().setStyle({ 'popGesture': 'none' });
			// #endif
		}
		uni.$on('update-popup', (data) => {
			console.log("触发+++>", data);
			updateResult.value = data;
		})
	})

	onShow(() => {
		if (!isIos.value) {
			// #ifdef APP-PLUS
			plus.key.addEventListener('backbutton', function () {
				// 可以在这里添加你的逻辑，比如提示用户、确认退出等
				// 如果想完全禁用，直接阻止默认行为即可
				plus.key.preventDefault();
			}, false);
			// #endif
		}
	})

	onHide(() => {
		if (!isIos.value) {
			// #ifdef APP-PLUS
			// 页面隐藏时移除监听，避免影响其他页面
			plus.key.removeEventListener('backbutton');
			// #endif
		}

	})
	onUnload(() => {
		uni.$off('update-popup')
	})
	
	const editPercent = (val)=>{
		
	}


	/**
	 * 升级
	 */
	const update = throttle(() => {
		if (percent.value > 0) return;
		let obj = updateResult.value;
		obj.edit=(val)=>{
			percent.value = val;
		}
		updateApp(obj);
	}, 2000);
</script>
