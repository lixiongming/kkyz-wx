		width: 240rpx;
		height: 248rpx;
	}

	.tips {
		position: absolute;
		top: 144rpx;
		left: 48rpx;
		color: #ffffff;
		font-family: "PingFang SC";
		font-size: 20rpx;
		font-style: normal;
		font-weight: 600;
		width: 174rpx;
		height: 32rpx;
		line-height: 32rpx;
		border-radius: 16rpx;
		background: linear-gradient(to right, #1CDAFE, #1A5AFF);
		text-align: center;
	}

	.versions {
		margin-top: 32rpx;
		position: relative;
		height: 40rpx;
		width: 622rpx;
		padding: 0 48rpx;
		color: #111111;
		font-size: 28rpx;
		font-weight: 600;
	}

	.content {
		margin-top: 24rpx;
