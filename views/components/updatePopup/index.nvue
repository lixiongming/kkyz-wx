		height: 192rpx;
		color: #111111;
		font-size: 28rpx;
		font-weight: 400;
	}

	.update {
		margin-top: 40rpx;
		width: 526rpx;
		height: 88rpx;
		line-height: 88rpx;
		flex-shrink: 0;
		border-radius: 16rpx;
		background-image: linear-gradient(to right, #1CDAFE, #00C2FF);
		margin-left: 48rpx;
	}

	.txt {
		color: #ffffff;
		font-size: 32rpx;
		font-weight: 500;
		text-align: center;
	}

	.no-update {
		margin-top: 24rpx;
		width: 526rpx;
		height: 48rpx;
		line-height: 48rpx;
		color: #777777;
