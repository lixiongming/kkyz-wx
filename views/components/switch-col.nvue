  padding: 32rpx 0;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  .switch-title {
    flex: 1;
    .title-text {
      color: #111111;
      font-size: 28rpx;
      font-weight: 500;
    }
