<template>
  <view class="switch-item">
    <view class="switch-title">
      <text class="title-text">{{ data.title }}</text>
    </view>
    <uv-switch
      v-model="data.value"
      :activeValue="activeValue"
      :inactiveValue="inactiveValue"
      activeColor="#1CDAFE"
      inactiveColor="#ddd"
      size="20"
      @change="switchChanges"
    ></uv-switch>
  </view>
</template>

<script setup lang="ts">
import { ref, defineProps } from "vue";
const props = defineProps(["data", "inactiveValue", "activeValue"]);
const emits = defineEmits(["edit"]);

const switchChanges = (e: any) => {
  emits("edit", props.data);
};
</script>
